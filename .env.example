# One file for everything: Test Bench, agent servers, browser-use bench, MetaGPT bench.
# Copy: cp .env.example .env  then paste your OpenAI key (same key you use for benchmarks).
OPENAI_API_KEY=sk-your-openai-key-here

# Demo: offline search for search_loop_trap + shared_ledger scenarios
SEARCH_BACKEND=corpus

# Optional
# TOKENOPS_CONFIG=src/tokenops/config/default.yaml
# OPENAI_BASE_URL=https://api.openai.com/v1
# SEARCH_TIMEOUT=20
